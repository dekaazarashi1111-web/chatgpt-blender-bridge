{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dekaazarashi1111-web/chatgpt-blender-bridge/creative-job.schema.json",
  "title": "Creative workspace job (version 2)",
  "description": "Store at projects/<project_id>/jobs/<job_id>/job.json. The stdlib validator additionally verifies matching IDs, file existence, checksums, duplicate targets/steps, script syntax, and safe project ownership. Script params are limited to 32768 serialized bytes and eight nesting levels. Execution requires the isolated runtime; validation is not a Python sandbox.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "job_id",
    "title",
    "steps"
  ],
  "properties": {
    "schema_version": {
      "const": 2,
      "type": "integer"
    },
    "project_id": {
      "$ref": "#/$defs/identifier"
    },
    "job_id": {
      "$ref": "#/$defs/identifier"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S"
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 30,
      "maximum": 19800,
      "default": 18000
    },
    "review_required": {
      "type": "boolean",
      "default": true
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000,
        "pattern": "\\S"
      },
      "default": [
        "Inspect generated previews against the project references before completion."
      ]
    },
    "inputs": {
      "type": "array",
      "maxItems": 4096,
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "target",
          "sha256"
        ],
        "properties": {
          "path": {
            "allOf": [
              {
                "$ref": "#/$defs/relativePath"
              },
              {
                "pattern": "^projects/[A-Za-z0-9][A-Za-z0-9._-]{0,79}/(inputs|source)/"
              }
            ]
          },
          "target": {
            "$ref": "#/$defs/relativePath"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "resume": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_tag",
        "project_id",
        "job_id",
        "archive_sha256",
        "manifest_sha256"
      ],
      "properties": {
        "release_tag": {
          "type": "string",
          "pattern": "^creative-[A-Za-z0-9][A-Za-z0-9._-]{0,220}$"
        },
        "project_id": {
          "$ref": "#/$defs/identifier"
        },
        "job_id": {
          "$ref": "#/$defs/identifier"
        },
        "archive_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "release_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "archive_asset_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "manifest_asset_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "release_url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^https://[^\\u0000-\\u001f]+$",
          "description": "Informational only. Restoration resolves the pinned tag through the GitHub API."
        },
        "archive_url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^https://[^\\u0000-\\u001f]+$",
          "description": "Informational only. Restoration resolves the pinned tag through the GitHub API."
        },
        "manifest_url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^https://[^\\u0000-\\u001f]+$",
          "description": "Informational only. Restoration resolves the pinned tag through the GitHub API."
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "current_step": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "tool",
              "script"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/identifier"
              },
              "params": {
                "type": "object",
                "default": {}
              },
              "timeout_seconds": {
                "type": "integer",
                "minimum": 30,
                "maximum": 19800
              },
              "tool": {
                "const": "blender"
              },
              "script": {
                "allOf": [
                  {
                    "$ref": "#/$defs/relativePath"
                  },
                  {
                    "pattern": "\\.py$"
                  }
                ]
              },
              "source_blend": {
                "allOf": [
                  {
                    "allOf": [
                      {
                        "$ref": "#/$defs/relativePath"
                      },
                      {
                        "pattern": "^(input|workspace)/"
                      }
                    ]
                  },
                  {
                    "pattern": "\\.blend$"
                  }
                ]
              },
              "preview": {
                "$ref": "#/$defs/preview"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "tool",
              "script"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/identifier"
              },
              "params": {
                "type": "object",
                "default": {}
              },
              "timeout_seconds": {
                "type": "integer",
                "minimum": 30,
                "maximum": 19800
              },
              "tool": {
                "const": "python"
              },
              "script": {
                "allOf": [
                  {
                    "$ref": "#/$defs/relativePath"
                  },
                  {
                    "pattern": "\\.py$"
                  }
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "tool",
              "operation",
              "params"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/identifier"
              },
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "input",
                  "output",
                  "width",
                  "height"
                ],
                "properties": {
                  "input": {
                    "allOf": [
                      {
                        "$ref": "#/$defs/relativePath"
                      },
                      {
                        "pattern": "^(input|workspace)/"
                      },
                      {
                        "pattern": "\\.([pP][nN][gG]|[jJ][pP][gG]|[jJ][pP][eE][gG]|[wW][eE][bB][pP]|[tT][iI][fF]|[tT][iI][fF][fF]|[bB][mM][pP]|[tT][gG][aA]|[eE][xX][rR]|[hH][dD][rR])$"
                      }
                    ]
                  },
                  "output": {
                    "allOf": [
                      {
                        "$ref": "#/$defs/relativePath"
                      },
                      {
                        "pattern": "\\.([pP][nN][gG]|[jJ][pP][gG]|[jJ][pP][eE][gG]|[wW][eE][bB][pP]|[tT][iI][fF]|[tT][iI][fF][fF]|[bB][mM][pP]|[tT][gG][aA]|[eE][xX][rR]|[hH][dD][rR])$"
                      }
                    ]
                  },
                  "quality": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100,
                    "default": 95
                  },
                  "width": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 16384
                  },
                  "height": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 16384
                  }
                }
              },
              "timeout_seconds": {
                "type": "integer",
                "minimum": 30,
                "maximum": 19800
              },
              "tool": {
                "const": "imagemagick"
              },
              "operation": {
                "const": "resize"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "tool",
              "operation",
              "params"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/identifier"
              },
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "input",
                  "output"
                ],
                "properties": {
                  "input": {
                    "allOf": [
                      {
                        "$ref": "#/$defs/relativePath"
                      },
                      {
                        "pattern": "^(input|workspace)/"
                      },
                      {
                        "pattern": "\\.([pP][nN][gG]|[jJ][pP][gG]|[jJ][pP][eE][gG]|[wW][eE][bB][pP]|[tT][iI][fF]|[tT][iI][fF][fF]|[bB][mM][pP]|[tT][gG][aA]|[eE][xX][rR]|[hH][dD][rR])$"
                      }
                    ]
                  },
                  "output": {
                    "allOf": [
                      {
                        "$ref": "#/$defs/relativePath"
                      },
                      {
                        "pattern": "\\.([pP][nN][gG]|[jJ][pP][gG]|[jJ][pP][eE][gG]|[wW][eE][bB][pP]|[tT][iI][fF]|[tT][iI][fF][fF]|[bB][mM][pP]|[tT][gG][aA]|[eE][xX][rR]|[hH][dD][rR])$"
                      }
                    ]
                  },
                  "quality": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100,
                    "default": 95
                  }
                }
              },
              "timeout_seconds": {
                "type": "integer",
                "minimum": 30,
                "maximum": 19800
              },
              "tool": {
                "const": "imagemagick"
              },
              "operation": {
                "const": "convert"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "tool",
              "operation",
              "params"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/identifier"
              },
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "input",
                  "output"
                ],
                "properties": {
                  "input": {
                    "allOf": [
                      {
                        "$ref": "#/$defs/relativePath"
                      },
                      {
                        "pattern": "^(input|workspace)/"
                      }
                    ]
                  },
                  "output": {
                    "allOf": [
                      {
                        "$ref": "#/$defs/relativePath"
                      },
                      {
                        "pattern": "\\.([mM][pP]4|[wW][eE][bB][mM])$"
                      }
                    ]
                  },
                  "width": {
                    "type": "integer",
                    "minimum": 2,
                    "maximum": 8192,
                    "multipleOf": 2
                  },
                  "fps": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 120,
                    "default": 24
                  },
                  "crf": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 51,
                    "default": 18
                  }
                }
              },
              "timeout_seconds": {
                "type": "integer",
                "minimum": 30,
                "maximum": 19800
              },
              "tool": {
                "const": "ffmpeg"
              },
              "operation": {
                "const": "encode"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "tool",
              "operation",
              "params"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/identifier"
              },
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "input",
                  "output"
                ],
                "properties": {
                  "input": {
                    "allOf": [
                      {
                        "$ref": "#/$defs/relativePath"
                      },
                      {
                        "pattern": "^(input|workspace)/"
                      }
                    ]
                  },
                  "output": {
                    "allOf": [
                      {
                        "$ref": "#/$defs/relativePath"
                      },
                      {
                        "pattern": "\\.([pP][nN][gG]|[jJ][pP][gG]|[jJ][pP][eE][gG])$"
                      }
                    ]
                  },
                  "width": {
                    "type": "integer",
                    "minimum": 2,
                    "maximum": 8192,
                    "multipleOf": 2
                  },
                  "time_seconds": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 86400,
                    "default": 0
                  }
                }
              },
              "timeout_seconds": {
                "type": "integer",
                "minimum": 30,
                "maximum": 19800
              },
              "tool": {
                "const": "ffmpeg"
              },
              "operation": {
                "const": "thumbnail"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "tool",
              "operation",
              "params"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/identifier"
              },
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "input",
                  "output"
                ],
                "properties": {
                  "input": {
                    "allOf": [
                      {
                        "$ref": "#/$defs/relativePath"
                      },
                      {
                        "pattern": "^(input|workspace)/"
                      },
                      {
                        "pattern": "\\.([pP][nN][gG]|[jJ][pP][gG]|[jJ][pP][eE][gG]|[wW][eE][bB][pP]|[tT][iI][fF]|[tT][iI][fF][fF]|[bB][mM][pP]|[tT][gG][aA]|[eE][xX][rR]|[hH][dD][rR]|[kK][rR][aA]|[oO][rR][aA]|[pP][sS][dD])$"
                      }
                    ]
                  },
                  "output": {
                    "allOf": [
                      {
                        "$ref": "#/$defs/relativePath"
                      },
                      {
                        "pattern": "\\.([pP][nN][gG]|[jJ][pP][gG]|[jJ][pP][eE][gG]|[wW][eE][bB][pP]|[tT][iI][fF]|[tT][iI][fF][fF])$"
                      }
                    ]
                  }
                }
              },
              "timeout_seconds": {
                "type": "integer",
                "minimum": 30,
                "maximum": 19800
              },
              "tool": {
                "const": "krita"
              },
              "operation": {
                "const": "export"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "tool",
              "operation",
              "params"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/identifier"
              },
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "input",
                  "output"
                ],
                "properties": {
                  "input": {
                    "allOf": [
                      {
                        "$ref": "#/$defs/relativePath"
                      },
                      {
                        "pattern": "^(input|workspace)/"
                      },
                      {
                        "pattern": "\\.[pP][tT][eE][xX]$"
                      }
                    ]
                  },
                  "output": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
                  },
                  "maps": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 8,
                    "uniqueItems": true,
                    "items": {
                      "enum": [
                        "albedo",
                        "roughness",
                        "metallic",
                        "normal",
                        "height",
                        "ao",
                        "emission",
                        "sss"
                      ]
                    },
                    "default": [
                      "albedo"
                    ]
                  }
                }
              },
              "timeout_seconds": {
                "type": "integer",
                "minimum": 30,
                "maximum": 19800
              },
              "tool": {
                "const": "material_maker"
              },
              "operation": {
                "const": "export"
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!\\.\\.?(/|$))(?!.*\\/\\.\\.?(\\/|$))[^/\\\\:\\u0000-\\u001f\\u007f]+(?:/[^/\\\\:\\u0000-\\u001f\\u007f]+)*$"
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "views",
        "width",
        "height",
        "samples"
      ],
      "properties": {
        "views": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "front",
              "right",
              "back",
              "left",
              "three_quarter"
            ]
          }
        },
        "width": {
          "type": "integer",
          "minimum": 128,
          "maximum": 2048
        },
        "height": {
          "type": "integer",
          "minimum": 128,
          "maximum": 2048
        },
        "samples": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        }
      }
    }
  }
}
